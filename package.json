{
  "name": "obsidian-budgetbase",
  "version": "0.1.0",
  "description": "Budget allocation tracking for Obsidian - markdown underneath, rich UI on top",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "bump:manifest": "node scripts/bump-manifest-version.mjs",
    "verify:deploy": "node scripts/verify-plugin-copy.mjs",
    "deploy:mobile-ready": "npm run bump:manifest && make deploy && make verify-deploy"
  },
  "keywords": [
    "obsidian",
    "budget",
    "finance",
    "visx"
  ],
  "author": "Conner Verret",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.27.2",
    "esbuild-plugin-copy": "^2.1.0",
    "jsdom": "^27.4.0",
    "obsidian": "latest",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "preact": "^10.28.0"
  }
}
